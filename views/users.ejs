<%- include('partials/header', { title: 'Library members' }) %>
<% const formatJoined = value => value ? new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'; %>
<div class="page-heading">
  <div>
    <span class="eyebrow">Cardholder directory</span>
    <h1>Library members</h1>
    <p>Registered readers and cardholders in The Reading Room.</p>
  </div>
</div>
<section class="panel">
  <% if (!users.length) { %>
    <div class="empty"><h3>No registered members</h3><p>Cardholder accounts will appear in this directory as readers register.</p></div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Cardholder</th><th>Email address</th><th>Member since</th></tr></thead>
        <tbody>
          <% users.forEach(member => { %>
            <tr>
              <td><strong><%= member.name %></strong></td>
              <td><%= member.email %></td>
              <td><%= formatJoined(member.createdAt) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>