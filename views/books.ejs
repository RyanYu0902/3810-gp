<%- include('partials/header', { title: manager ? 'Manage books' : 'Explore books' }) %>
<div class="page-heading"><div><span class="eyebrow"><%= manager ? 'Library catalogue' : 'Search the collection' %></span><h1><%= manager ? 'Book catalogue' : 'Find a book in the catalogue' %></h1><p><%= manager ? 'Add titles and keep catalogue details current.' : 'Search by title, author, category or ISBN.' %></p></div><% if (manager) { %><a class="button primary" href="/manager/books/add">Add a book <span aria-hidden="true">→</span></a><% } %></div>
<% if (!manager) { %><form class="search" method="get" action="/user/books"><span aria-hidden="true">⌕</span><label class="sr-only" for="catalogue-search">Search books</label><input id="catalogue-search" name="q" value="<%= search %>" placeholder="Title, author, category or ISBN"><button class="button primary" type="submit">Search</button></form><% } %>
<div class="collection-heading"><div><span class="eyebrow"><%= search ? 'Search results' : 'Available titles' %></span><h2><%= search ? 'Results for “' + search + '”' : 'All books' %></h2></div><span class="muted"><%= books.length %> <%= books.length === 1 ? 'title' : 'titles' %></span></div>
<% if (!books.length) { %><div class="empty panel"><h3>No matching titles</h3><p><%= search ? 'Try a different title, author, category or ISBN.' : 'There are no books in the catalogue yet.' %></p></div><% } else { %>
<div class="book-grid"><% books.forEach((book, index) => { %>
  <% if (manager) { %><article class="book-card"><% } else { %><a class="book-card" href="/user/books/<%= book._id %>" aria-label="View details for <%= book.title %>"><% } %>
    <div class="book-cover cover-<%= index % 5 %>"><span><%= book.category %></span><h3><%= book.title %></h3><small><%= book.author %></small><div class="cover-decoration" aria-hidden="true"></div></div>
    <div class="book-info"><div class="book-meta"><span class="availability"><%= book.availableCopies %> available</span></div><div class="card-bottom"><% if (manager) { %><a class="link" href="/manager/books/<%= book._id %>/edit">Edit details <span aria-hidden="true">→</span></a><form method="post" action="/manager/books/<%= book._id %>/delete" onsubmit="return confirm('Delete this book?')"><button class="text-button danger" type="submit">Delete</button></form><% } else { %><span class="link">View book details <span aria-hidden="true">→</span></span><% } %></div></div>
  <% if (manager) { %></article><% } else { %></a><% } %>
<% }) %></div><% } %>
<%- include('partials/footer') %>
