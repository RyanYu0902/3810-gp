<%- include('partials/header', { title: manager ? 'Catalog management' : 'Book catalogue' }) %>
<div class="page-heading">
  <div>
    <span class="eyebrow"><%= manager ? 'Shelf & catalog management' : 'Search the stacks' %></span>
    <h1><%= manager ? 'Library book catalogue' : 'Explore the library catalogue' %></h1>
    <p><%= manager ? 'Add new volumes, update shelf locations and maintain copy counts.' : 'Search holdings by title, author, subject category or ISBN.' %></p>
  </div>
  <% if (manager) { %><a class="button primary" href="/manager/books/add">Catalog a book <span aria-hidden="true">→</span></a><% } %>
</div>
<% if (!manager) { %>
  <form class="search" method="get" action="/user/books">
    <span aria-hidden="true">⌕</span>
    <label class="sr-only" for="catalogue-search">Search books in the catalogue</label>
    <input id="catalogue-search" name="q" value="<%= search %>" placeholder="Search title, author, category or ISBN">
    <button class="button primary" type="submit">Search catalogue</button>
  </form>
<% } %>
<div class="collection-heading">
  <div>
    <span class="eyebrow"><%= search ? 'Search index' : 'Collection holdings' %></span>
    <h2><%= search ? 'Matching titles for “' + search + '”' : 'All catalogued volumes' %></h2>
  </div>
  <span class="muted"><%= books.length %> <%= books.length === 1 ? 'volume' : 'volumes' %></span>
</div>
<% if (!books.length) { %>
  <div class="empty panel">
    <h3>No volumes found</h3>
    <p><%= search ? 'No catalogued items matched that query. Try another title, author, category or ISBN.' : 'No books have been catalogued yet.' %></p>
  </div>
<% } else { %>
  <div class="book-grid">
    <% books.forEach((book, index) => { %>
      <% if (manager) { %><article class="book-card"><% } else { %><a class="book-card" href="/user/books/<%= book._id %>" aria-label="View catalog record for <%= book.title %>"><% } %>
        <div class="book-cover cover-<%= index % 5 %>">
          <span><%= book.category %></span>
          <h3><%= book.title %></h3>
          <small><%= book.author %></small>
          <div class="cover-decoration" aria-hidden="true"></div>
        </div>
        <div class="book-info">
          <div class="book-meta">
            <span><%= book.type %></span>
            <span class="availability"><%= book.availableCopies %> of <%= book.totalCopies %> available</span>
          </div>
          <h3><%= book.title %></h3>
          <p><%= book.author %></p>
          <div class="card-bottom">
            <% if (manager) { %>
              <a class="link" href="/manager/books/<%= book._id %>/edit">Edit record <span aria-hidden="true">→</span></a>
              <form method="post" action="/manager/books/<%= book._id %>/delete" onsubmit="return confirm('Remove this book from the catalogue?')">
                <button class="text-button danger" type="submit">Remove</button>
              </form>
            <% } else { %>
              <span class="link">Inspect volume <span aria-hidden="true">→</span></span>
            <% } %>
          </div>
        </div>
      <% if (manager) { %></article><% } else { %></a><% } %>
    <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>