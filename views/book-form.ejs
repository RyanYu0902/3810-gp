<%- include('partials/header', { title: book ? 'Edit book' : 'Add book' }) %>
<a class="back-link" href="/manager/books"><span aria-hidden="true">←</span> Back to catalogue</a><div class="page-heading"><div><span class="eyebrow">Library catalogue</span><h1><%= book ? 'Edit book details' : 'Add a book' %></h1><p>Keep title, copy and shelf information current.</p></div></div>
<section class="panel form-panel"><form class="form-stack" method="post" action="<%= book ? '/manager/books/' + book._id + '/edit' : '/manager/books' %>"><div class="form-grid"><label>Title<input name="title" required maxlength="200" value="<%= book ? book.title : '' %>"></label><label>Author<input name="author" required maxlength="150" value="<%= book ? book.author : '' %>"></label><label>ISBN<input name="isbn" required maxlength="30" value="<%= book ? book.isbn : '' %>"></label><label>Category<input name="category" required maxlength="100" value="<%= book ? book.category : '' %>"></label><label>Resource type<select name="type"><option <%= !book || book.type === 'Physical Book' ? 'selected' : '' %>>Physical Book</option><option <%= book && book.type === 'E-book' ? 'selected' : '' %>>E-book</option></select></label><label>Total copies<input name="totalCopies" type="number" min="0" step="1" required value="<%= book ? book.totalCopies : 1 %>"></label><label>Shelf location<input name="shelfLocation" maxlength="100" value="<%= book ? book.shelfLocation : '' %>"></label></div><label>Description<textarea name="description" rows="5" maxlength="5000"><%= book ? book.description : '' %></textarea></label><div><button class="button primary" type="submit"><%= book ? 'Save changes' : 'Add book' %><span aria-hidden="true"> →</span></button></div></form></section>
<%- include('partials/footer') %>
