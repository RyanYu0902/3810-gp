<!doctype html>
<% const activePath = typeof currentPath === 'undefined' ? '' : currentPath; %>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="Search the library catalogue, request books and manage borrowing records.">
  <meta name="theme-color" content="#0c263f">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>The Reading Room</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/reading-room.css">
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell <%= user ? '' : 'guest-shell' %>">
  <% if (user) { %>
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="The Reading Room home">
        <span class="brand-mark" aria-hidden="true">R</span>
        <span><span class="brand-title">The Reading Room</span><small>Library catalogue</small></span>
      </a>
      <div class="nav-label">Library workspace</div>
      <nav aria-label="Main navigation">
        <a href="/<%= user.role %>/dashboard" <% if (activePath === '/' + user.role + '/dashboard') { %>aria-current="page"<% } %>><span class="nav-mark" aria-hidden="true">01</span><span>Overview</span></a>
        <% if (user.role === 'manager') { %>
          <a href="/manager/books" <% if (activePath.startsWith('/manager/books')) { %>aria-current="page"<% } %>><span class="nav-mark" aria-hidden="true">02</span><span>Book catalogue</span></a>
          <a href="/manager/borrow-requests" <% if (activePath === '/manager/borrow-requests') { %>aria-current="page"<% } %>><span class="nav-mark" aria-hidden="true">03</span><span>Requests</span></a>
          <a href="/manager/borrow-records" <% if (activePath === '/manager/borrow-records') { %>aria-current="page"<% } %>><span class="nav-mark" aria-hidden="true">04</span><span>Borrowing records</span></a>
          <a href="/manager/users" <% if (activePath === '/manager/users') { %>aria-current="page"<% } %>><span class="nav-mark" aria-hidden="true">05</span><span>Members</span></a>
        <% } else { %>
          <a href="/user/books" <% if (activePath.startsWith('/user/books')) { %>aria-current="page"<% } %>><span class="nav-mark" aria-hidden="true">02</span><span>Book catalogue</span></a>
          <a href="/user/my-borrowings" <% if (activePath === '/user/my-borrowings' || activePath === '/user/history') { %>aria-current="page"<% } %>><span class="nav-mark" aria-hidden="true">03</span><span>My borrowing</span></a>
        <% } %>
      </nav>
      <div class="sidebar-bottom">
        <div class="profile"><span class="avatar" aria-hidden="true"><%= user.name.charAt(0).toUpperCase() %></span><span><strong><%= user.name %></strong><small><%= user.role === 'manager' ? 'Library manager' : 'Library member' %></small></span></div>
        <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit">Sign out →</button></form>
      </div>
    </aside>
  <% } %>
  <main class="main-content" id="main-content" tabindex="-1">
    <% if (user) { %><div class="topline"><span><%= title || 'Library workspace' %></span><span><%= user.role === 'manager' ? 'Manager workspace' : 'Member workspace' %></span></div><% } %>
    <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
