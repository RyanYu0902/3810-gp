<%- include('partials/header', { title: book.title }) %>
<a class="back-link" href="/user/books"><span aria-hidden="true">←</span> Back to catalogue</a>
<div class="detail-layout"><div class="book-cover detail-cover cover-1"><span><%= book.category %></span><strong><%= book.title %></strong><small><%= book.author %></small><div class="cover-decoration" aria-hidden="true"></div></div><div class="detail-content"><span class="eyebrow"><%= book.category %> · <%= book.type %></span><h1><%= book.title %></h1><p class="detail-author">by <%= book.author %></p><span class="badge <%= book.availableCopies ? 'returned' : 'overdue' %>"><%= book.availableCopies %> of <%= book.totalCopies %> copies available</span><h2>Book description</h2><p class="description"><%= book.description || 'No description available yet.' %></p><div class="detail-meta"><div><span>ISBN</span><strong><%= book.isbn %></strong></div><div><span>Shelf location</span><strong><%= book.shelfLocation || 'Not specified' %></strong></div></div><% if (book.type === 'Physical Book' && book.availableCopies > 0) { %><form method="post" action="/user/books/<%= book._id %>/request"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Request to borrow <span aria-hidden="true">→</span></button></form><p class="muted small">A library manager reviews requests before a book is issued.</p><% } else { %><p class="muted">This resource is not currently available to borrow.</p><% } %></div></div>
<%- include('partials/footer') %>
