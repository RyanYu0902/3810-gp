<%- include('partials/header', { title: mode === 'login' ? 'Sign in' : 'Register card' }) %>
<div class="auth-layout">
  <section class="auth-story">
    <a class="brand light" href="/" aria-label="The Reading Room home">
      <span class="brand-mark" aria-hidden="true">R</span>
      <span><span class="brand-title">The Reading Room</span><small>Catalog &amp; Circulation Desk</small></span>
    </a>
    <div>
      <span class="eyebrow">Public &amp; staff access</span>
      <h1>Open the stacks, borrow with ease</h1>
      <p>Browse the catalogue, place hold requests and manage your reading loans in one quiet digital reading room.</p>
    </div>
    <span class="auth-note">Cardholders &amp; circulation librarians</span>
  </section>
  <section class="auth-panel">
    <div class="auth-box">
      <span class="eyebrow">The Reading Room</span>
      <h2><%= mode === 'login' ? 'Sign in to your account' : 'Request a member account' %></h2>
      <p class="muted"><%= mode === 'login' ? 'Enter your credentials to access the reading room.' : 'Register to search holdings and request books.' %></p>
      <form method="post" action="/<%= mode %>" class="form-stack">
        <% if (mode === 'register') { %><label>Full name<input name="name" autocomplete="name" maxlength="100" required></label><% } %>
        <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="reader@example.com"></label>
        <label>Password<input name="password" type="password" autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>" required minlength="8" placeholder="At least 8 characters"></label>
        <button class="button primary full" type="submit"><%= mode === 'login' ? 'Enter reading room' : 'Create member account' %><span aria-hidden="true">→</span></button>
      </form>
      <% if (typeof googleAuthEnabled !== 'undefined' && googleAuthEnabled) { %>
        <a class="button secondary google-sign-in" href="/auth/google">Continue with Google</a>
      <% } %>
      <p class="auth-switch"><%= mode === 'login' ? 'Need a library account?' : 'Already a member?' %> <a href="/<%= mode === 'login' ? 'register' : 'login' %>"><%= mode === 'login' ? 'Create an account' : 'Sign in' %></a></p>
    </div>
  </section>
</div>
<%- include('partials/footer') %>